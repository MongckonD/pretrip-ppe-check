{
  "name": "pretrip-ppe-check",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:store": "vite --mode store",
    "dev:cf": "vite --mode cloudflare",
    "dev:api": "wrangler dev --port 8787",
    "build": "node tests/no-popups.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:delivery": "node tests/delivery-plan.test.mjs",
    "check:popups": "node tests/no-popups.mjs",
    "db:migrate:local": "wrangler d1 migrations apply pretrip-ppe --local",
    "db:migrate:remote": "wrangler d1 migrations apply pretrip-ppe --remote",
    "cf-types": "wrangler types worker/worker-configuration.d.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.162.0"
  }
}
